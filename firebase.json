{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {"source": "/pwa/service-worker.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}]}
    ]
  },
  "firestore": {"rules": "firebase/firestore-rules.txt", "indexes": "firebase/firestore-indexes.json"},
  "storage": {"rules": "firebase/storage-rules.txt"}
}
