{
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/pwa/service-worker.js", "headers": [{"key":"Cache-Control","value":"no-cache"}]},
    {"source": "/pwa/manifest.json", "headers": [{"key":"Cache-Control","value":"no-cache"}]},
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}
  ]
}
